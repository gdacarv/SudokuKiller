  m_TableData:
  - m_Id: 16323174400
    m_Localized: "{0} estava em um canto do c\xF4modo"
    m_Metadata:
      m_Items: []
  - m_Id: 593899537031168
    m_Localized: "{0} n\xE3o \xE9 a pessoa mais pr\xF3xima da {char.victim}!"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 599727119785984
    m_Localized: "O(a) Assassino(a) era a pessoa mais pr\xF3xima d{objectGender:choose(male|female):o|a|o}
      {object}"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 1689794882035712
    m_Localized: '{0} estava em um tapete{color: {}|}'
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 1707510711967744
    m_Localized: '{0} estava sentad{gender:choose(male|female|other):o|a|a} em uma
      cadeira'
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 7279246115332096
    m_Localized: "{0} era a \xFAnica pessoa em {object}"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 7564429443981312
    m_Localized: "{char.carla} era a \xFAnica pessoa em sua linha e coluna"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 7564429460758528
    m_Localized: "{0} estava sozinh{gender:choose(male|female):o|a|o} no c\xF4modo"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 7564429460758529
    m_Localized: "{char.adam} era a \xFAnica pessoa em sua linha e coluna"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 7564429460758530
    m_Localized: "A V\xEDtima era a \xFAnica pessoa no c\xF4modo com o Assassino"
    m_Metadata:
      m_Items: []
  - m_Id: 7564429460758531
    m_Localized: "A V\xEDtima estava abaixo de {char.carla}"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 7564429460758532
    m_Localized: "{0} era a \xFAnica pessoa em sua linha e coluna"
    m_Metadata:
      m_Items: []
  - m_Id: 7564429460758533
    m_Localized: "{0} \xE9 uma Crian\xE7a"
    m_Metadata:
      m_Items: []
  - m_Id: 7564429460758534
    m_Localized: "Havia mais gente no mesmo c\xF4modo de {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 7564429460758535
    m_Localized: "{0} era a \xFAnica pessoa em sua coluna"
    m_Metadata:
      m_Items: []
  - m_Id: 10118092045672448
    m_Localized: "{useArticle:{gender:choose(male|female):O|A|O(A)} |}{0} estava
      pr\xF3xim{gender:choose(male|female):o|a|o(a)} de {colorObject}"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 10138690801098752
    m_Localized: "{0} era a \xFAnica pessoa adulta em sua linha e coluna"
    m_Metadata:
      m_Items: []
  - m_Id: 15982772018470912
    m_Localized: '{0} estava acima de {object}'
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 27414966213533696
    m_Localized: Tinha apenas uma pessoa por cada linha e coluna
    m_Metadata:
      m_Items: []
  - m_Id: 36118547489873920
    m_Localized: '{0} ainda estava usando sapatos'
    m_Metadata:
      m_Items: []
  - m_Id: 36468701376012288
    m_Localized: "{0} n\xE3o estava em {object}"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 36477824872210432
    m_Localized: Tinha apenas um Adulto por cada linha e coluna
    m_Metadata:
      m_Items: []
  - m_Id: 41892628617224192
    m_Localized: '{0} estava ouvindo o gramofone'
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 41892628642390016
    m_Localized: '{0} estava em uma almofada'
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 41892628642390017
    m_Localized: "{0} estava de p\xE9 junto a {object}"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 41892628642390018
    m_Localized: '{0} estava acima de {char.fatima}'
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 41892628642390019
    m_Localized: "{0} estava perto do bonsai do escrit\xF3rio"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 41892628642390020
    m_Localized: '{0} estava cochilando ao lado de uma cama'
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 41892628642390021
    m_Localized: "{0} estava perto da c\xF4moda"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 41892628642390022
    m_Localized: "{0} estava \xE0 mesa de jantar"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 41892628642390023
    m_Localized: "A V\xEDtima foi encontrada ao lado de um bonsai"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 41892628642390024
    m_Localized: "{0} n\xE3o passou do capacho"
    m_Metadata:
      m_Items:
      - rid: 6722194458415989153
  - m_Id: 45168987275780096
    m_Localized: "{useArticle:{gender:choose(male|female):O|A|O(A)} |}{0} \xE9 uma
